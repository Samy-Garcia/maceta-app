{
  "expo": {
    "name": "Macetas503",
    "slug": "macetas-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.lissy190816.macetasapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Macetas necesita acceso a tu galería para que elijas una foto de perfil.",
          "cameraPermission": "Macetas necesita acceso a tu cámara para tomarte una foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F9F5"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "macetas503",
    "extra": {
      "eas": {
        "projectId": "03071763-840c-4168-af0d-bfcb8187a682"
      }
    }
  }
}
